# App
NODE_ENV=development
DEMO_MODE=true
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000
PORT=3000

# Database - create a local PostgreSQL database for development
DATABASE_URL=postgresql://srqms:srqms_dev_password@localhost:5432/srqms_dev?schema=public

# Session/auth: replace with a long random value; do not commit real secrets
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_bytes

# Optional integrations; app must work if both are unset
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=false

# Demo-only notification / queue defaults
QUEUE_REFRESH_SECONDS=4
DEFAULT_ESTIMATED_SERVICE_MINUTES=3.5
LOG_LEVEL=info
